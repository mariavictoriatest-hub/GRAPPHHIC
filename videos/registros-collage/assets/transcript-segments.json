 },
 {
  "start": 15.0,
  "end": 16.87,
  "text": "para resolver un problema."
 },
 {
  "start": 16.87,
  "end": 20.08,
  "text": "y lo que hacen los registros es como ir llevándonos."
 },
 {
  "start": 20.08,
