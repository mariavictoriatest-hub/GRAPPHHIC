[
 {
  "start": 0,
  "end": 1.66,
  "text": "¿Qué son los registros?"
 },
 {
  "start": 1.66,
  "end": 3.15,
  "text": "En realidad..."
 },
 {
  "start": 3.15,
  "end": 5.08,
  "text": "Para algunos es..."
 },
 {
  "start": 5.08,
  "end": 7.27,
  "text": "magia para otros"
 },
 {
  "start": 7.27,
  "end": 8.4,
  "text": "es"
 },
 {
  "start": 8.4,
  "end": 10.8,
  "text": "entender para otros"
 },
 {
  "start": 10.8,
  "end": 12.3,
  "text": "como un coach"
